{
  "name": "@pydantic/agent-webui",
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pydantic/ai-chat-ui.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "version": "2.6.3",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "graphos:client:gen": "openapi-typescript src/lib/graphos-api/generated/openapi.json -o src/lib/graphos-api/generated/schema.ts",
    "gate:no-fabrication": "node scripts/no_fabrication_gate.mjs",
    "site:assets": "node --experimental-strip-types scripts/generate-site-assets.mjs",
    "site:assets:check": "node --experimental-strip-types scripts/check-site-assets.mjs",
    "site:assets:test": "node scripts/site-assets-contract.test.mjs",
    "site:config:check": "node --experimental-strip-types scripts/check-site-config.mjs",
    "site:image-alt:check": "node scripts/check-image-alt.mjs",
    "site:brand:check": "node scripts/check-site-brand.mjs",
    "format": "prettier --write",
    "lint": "eslint",
    "lint-fix": "eslint --fix --quiet",
    "dev": "vite",
    "dev:server": "uv run python -m agent_webui.server --port 38001",
    "build": "node scripts/no_fabrication_gate.mjs && pnpm run site:assets:test && pnpm run site:assets && pnpm run site:assets:check && pnpm run site:config:check && pnpm run site:image-alt:check && pnpm run site:brand:check && tsc -b && vite build && node scripts/publish-dist.mjs",
    "preview": "vite preview --outDir agent/agent_webui/dist",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.66",
