    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3",
    "yaml-lint": "^1.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "prismjs": "1.30.0",
      "react": "19.3.0",
